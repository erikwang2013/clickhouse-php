{
    "name": "erikwang2013/clickhouse-php",
    "description": "PHP ClickHouse client over HTTP with query builder, schema builder, migration system and ORM, plus Laravel, ThinkPHP, Webman, Hyperf, Yii2 and Yii3 adapters.",
    "type": "library",
    "license": "MIT",
    "keywords": ["clickhouse", "database", "client", "php"],
    "authors": [
        {
            "name": "erik",
            "email": "erik@erik.xyz"
        }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "mockery/mockery": "^1.5"
    },
    "suggest": {
        "laravel/framework": "For Laravel integration (^10.0|^11.0)",
        "topthink/framework": "For ThinkPHP integration (^8.0)",
        "workerman/workerman": "For Webman integration (^4.0)",
        "hyperf/framework": "For Hyperf integration (^3.0)",
        "yiisoft/yii2": "For Yii2 integration (^2.0)",
        "yiisoft/config": "For Yii3 integration (^1.0)"
    },
    "autoload": {
        "psr-4": {
            "Erikwang2013\\ClickHouse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Erikwang2013\\ClickHouse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Erikwang2013\\ClickHouse\\Laravel\\ClickHouseServiceProvider"
            ]
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di": "di.php"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "test-integration": "phpunit --group integration"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
